pipeline {
    agent any

    stages {
        stage('Build') {
            agent {
                docker { image 'django:latest' }
            }
            steps {
                sh 'python3 manage.py check'
                echo 'Django syntax check completed. Proceeding to next stage...'
            }
        }

        stage('Deploy') {
            when {
                // Task 4: Deploy stage only executes when Git branch is 'develop'
                branch 'develop'
            }
            steps {
                // Task 2: Build the image
                sh 'docker build -t todo .'

                // Task 2: Run two containers on ports 8000 and 8001
                sh 'docker run -d -p 8000:8000 --name todo_container1 todo'
                sh 'docker run -d -p 8001:8000 --name todo_container2 todo'

                // Task 2: Verify both containers are running
                sh 'docker ps --filter "name=todo_container"'
            }
            post {
                always {
                    // Task 2: Stop and remove both containers after deployment
                    echo 'Stopping and removing deployed containers...'
                    sh 'docker stop todo_container1 todo_container2 || true'
                    sh 'docker rm todo_container1 todo_container2 || true'
                }
            }
        }
    }

    // Task 1: Pipeline-level execution handling
    post {
        success {
            echo 'Pipeline executed successfully'
        }
        failure {
            echo 'Pipeline execution failed'
        }
        always {
            echo 'Pipeline execution completed'
        }
    }
}
